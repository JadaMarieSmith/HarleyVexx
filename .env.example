# Environment Configuration
# Copy this file to .env and fill in your credentials

# Base44 Configuration
BASE44_APP_ID=harley-vexx-4-creators101-copy-6aa0dc21
BASE44_DOMAIN=base44.app

# Artist Credentials (Default Account)
ARTIST_EMAIL=jada@harleyvexx.com
ARTIST_PASSWORD=harleyvexx2026

# JWT & Authentication
JWT_SECRET=harleyvexx-secret-key-2026
TOKEN_EXPIRY=7d

# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/callback

# Twitter/X API v2 (Elevated Access)
# Get credentials from: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# SoundExchange Integration (Optional)
SOUNDEXCHANGE_API_KEY=your_soundexchange_key_here
SOUNDEXCHANGE_ACCOUNT_ID=performer_account_id

# Stripe Payments (Optional)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Email Configuration (Optional)
EMAIL_SERVICE=your_email_service
EMAIL_FROM=noreply@harleyvexx.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587

# Server Configuration
NODE_ENV=development
PORT=5173
HOST=localhost

# CORS & Security
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://harley-vexx-4-creators101-copy-6aa0dc21.base44.app

